# API のローカル開発用テンプレート。ローカルはこのまま .env にコピーで動きます:
#   cp apps/api/.env.example apps/api/.env
# ※ ここに書くのは「ローカル開発専用のダミー値」のみ。本番の実値はこのリポジトリに置かない
#    （本番テンプレートは .env.production.example、実値は VPS 上の .env で管理）。

# ローカル開発 DB。パスワードは docker-compose.yml の postgres と一致（localhost:5434）
DATABASE_URL="postgresql://stockhome:stockhome_dev_password@localhost:5434/stockhome?schema=public"

# JWT 署名鍵（ローカル開発用ダミー。本番は openssl rand -base64 48 等の強い値にする）
JWT_SECRET="dev-only-not-a-real-secret"
PORT=4002

# GASブリッジ共有トークン（本番は GAS 側スクリプトプロパティ STOCKHOME_BRIDGE_TOKEN と同値にする）
BRIDGE_TOKEN="dev-only-not-a-real-secret"
