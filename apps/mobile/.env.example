# モバイルアプリの接続先 VPS API。
# このファイル（.env.example）はコミットされます。実値は書かないこと。
#
# セットアップ（PC ごとに1回）:
#   cp apps/mobile/.env.example apps/mobile/.env
#   そして .env の URL を実際の StockHome API の HTTPS 入口に書き換える
#
# vps モード（npm run app:start）で参照されます。
# local モード（npm run app:start:local）では無視され、PC の LAN IP が自動判定されます。
EXPO_PUBLIC_API_BASE_URL=https://<your-stockhome-domain>

# VPS2の公開お知らせfeed（認証不要・GETのみ）。未設定の場合、お知らせは「取得できませんでした」表示になる
EXPO_PUBLIC_NOTICES_FEED_URL=https://<your-notices-feed-host>/notices/v1/feed.json

# Expo アカウント名（app.config.js の owner で参照。EAS Build/Update に必要）
EXPO_OWNER=<your-expo-username>
