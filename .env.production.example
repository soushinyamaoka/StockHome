# StockHome 本番環境変数（docker-compose.prod.yml 用）
# このファイルを .env にコピーして値を設定してください:
#   cp .env.production.example .env
# ※ ルートの .env は .gitignore 済み（コミットされません）

# --- PostgreSQL ---
POSTGRES_USER=stockhome
POSTGRES_PASSWORD=__change_me_strong_password__
POSTGRES_DB=stockhome

# --- API ---
# 長いランダム文字列を推奨（例: openssl rand -base64 48 で生成）
JWT_SECRET=__change_me_long_random_secret__

# nginx→APIコンテナ間の直前proxy IP（A-8対応、trustProxy設定・rate limitのIP解決に使用）。
# カンマ区切りで複数指定可。値はDocker bridge networkのgateway IPで、VPS管理側が
# 2026-09-20に実測した値は 172.19.0.1（Docker実装詳細に依存するため、ネットワーク再作成等で
# 変わる可能性がある。変わった場合はVPS管理側で再測定のうえ値を更新すること）。
TRUSTED_PROXY_IPS=172.19.0.1

# --- GAS ブリッジ連携 ---
# GAS（Gmail取込/ReadyGo通知ブリッジ）との共有シークレット
# GAS 側スクリプトプロパティ STOCKHOME_BRIDGE_TOKEN と同じ値にする
BRIDGE_TOKEN=__change_me_bridge_token__

# 過去候補の単価再解析route（notice 20260907-STOCKHOME-006）を有効化する一時フラグ。
# VPS管理側のproduction承認後にのみ 'true' を設定する。未設定時はrouteが404を返す
HISTORICAL_REPARSE_ENABLED=
HISTORICAL_REPARSE_WRITE_ENABLED=
